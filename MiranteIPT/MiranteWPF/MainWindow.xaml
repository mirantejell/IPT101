<Window x:Class="MiranteWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiranteWpfApp"
        mc:Ignorable="d"
        Title="Library" Height="450" Width="800"
        Background="CornflowerBlue">
    <Grid Margin="10">
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Library Management" VerticalAlignment="Top" FontSize="30"/>

        <Label Content="Full Name" HorizontalAlignment="Left" Margin="30,70,0,0" VerticalAlignment="Top" FontSize="15"/>
        <TextBox x:Name="txtFullName" HorizontalAlignment="Left" Margin="140,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230" FontSize="15"/>

        <Label Content="Course / Year" HorizontalAlignment="Left" Margin="30,110,0,0" VerticalAlignment="Top" FontSize="15"/>
        <TextBox x:Name="txtCourseYear" HorizontalAlignment="Left" Margin="140,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230" FontSize="15"/>

        <Label Content="Book Title" HorizontalAlignment="Left" Margin="30,150,0,0" VerticalAlignment="Top" FontSize="15"/>
        <TextBox x:Name="txtBookTitle" HorizontalAlignment="Left" Margin="140,150,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230" FontSize="15"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="140,190,0,0" VerticalAlignment="Top" >
            <Button x:Name="btnAdd" Content="Add" Width="70" Margin="0,0,8,0" Click="BtnAdd_Click"/>
            <Button x:Name="btnEdit" Content="Edit" Width="70" Margin="0,0,8,0" Click="BtnEdit_Click" IsEnabled="False"/>
            <Button x:Name="btnUpdate" Content="Update" Width="80" Margin="0,0,8,0" Click="BtnUpdate_Click" IsEnabled="False"/>
            <Button x:Name="btnDelete" Content="Delete" Width="70" Margin="0,0,8,0" Click="BtnDelete_Click" IsEnabled="False"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="70" Click="BtnCancel_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Search -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,230,0,0" VerticalAlignment="Top">
            <TextBox x:Name="txtSearch" Width="240" Height="26" Margin="0,0,8,0"/>
            <Button x:Name="btnSearch" Content="Search" Width="80" Click="BtnSearch_Click"/>
            <Button x:Name="btnClearSearch" Content="Clear" Width="70" Margin="8,0,0,0" Click="BtnClearSearch_Click"/>
        </StackPanel>

        <!-- List -->
        <ListBox x:Name="lstRecords" Margin="458,70,20,20" SelectionChanged="LstRecords_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="4" Background="White" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="{Binding FullName}" />
                            <TextBlock Text="{Binding CourseYear}" Foreground="Gray"/>
                            <TextBlock Text="{Binding BookTitle}" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>