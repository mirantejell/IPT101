        <TextBox HorizontalAlignment="Left" Margin="155,168,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="198" FontSize="15"/>
        <Label Content="BookTitle" HorizontalAlignment="Left" Margin="60,201,0,0" VerticalAlignment="Top" FontSize="15"/>
        <TextBox HorizontalAlignment="Left" Margin="155,208,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="198" FontSize="15"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="418,124,42,100"/>
